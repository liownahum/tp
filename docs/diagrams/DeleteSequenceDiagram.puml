@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam sequenceMessageAlign left
skinparam BoxPadding 3
skinparam SequenceReferenceBackgroundColor transparent

' Padding keeps the incoming call label inside the Logic box.
box Logic LOGIC_COLOR_T1
participant "      :LogicManager      " as LogicManager LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "r:\nCommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute(\n"delete 1")
activate LogicManager

ref over LogicManager, DeleteCommand
Parse "delete 1".
Return d.
See the parsing diagram.
end ref

LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand

DeleteCommand -> Model : getFilteredPersonList()
activate Model

Model --> DeleteCommand : lastShownList
deactivate Model

note over DeleteCommand
Resolve displayed index 1
in lastShownList to obtain
personToDelete.
end note

DeleteCommand -> Model : deletePerson(\npersonToDelete)
activate Model

Model --> DeleteCommand
deactivate Model

create CommandResult
DeleteCommand -> CommandResult : new\nCommandResult\n(success message)
activate CommandResult

CommandResult --> DeleteCommand : r
deactivate CommandResult

DeleteCommand --> LogicManager : r
deactivate DeleteCommand

[<-- LogicManager : r
deactivate LogicManager
@enduml
