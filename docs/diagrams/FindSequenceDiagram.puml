@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FindCommandParser" as FindCommandParser LOGIC_COLOR
participant "f:FindCommand" as FindCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "p:NameContainsKeywordsPredicate" as Predicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
participant "filteredPersons:FilteredList" as FilteredList MODEL_COLOR
participant "sortedPersons:SortedList" as SortedList MODEL_COLOR
end box

[-> LogicManager : execute("find ali")
activate LogicManager
LogicManager -> AddressBookParser : parseCommand("find ali")
activate AddressBookParser

create FindCommandParser
AddressBookParser -> FindCommandParser
activate FindCommandParser
FindCommandParser --> AddressBookParser
deactivate FindCommandParser

AddressBookParser -> FindCommandParser : parse(" ali")
activate FindCommandParser
note right of FindCommandParser
Trim arguments and split on whitespace:
keywords = ["ali"]
end note

create Predicate
FindCommandParser -> Predicate : new NameContainsKeywordsPredicate(keywords)
activate Predicate
Predicate --> FindCommandParser : p
deactivate Predicate

create FindCommand
FindCommandParser -> FindCommand : new FindCommand(p)
activate FindCommand
FindCommand --> FindCommandParser : f
deactivate FindCommand
FindCommandParser --> AddressBookParser : f
deactivate FindCommandParser
AddressBookParser --> LogicManager : f
deactivate AddressBookParser

LogicManager -> FindCommand : execute(m)
activate FindCommand
FindCommand -> Model : updateFilteredPersonList(p)
activate Model
Model -> FilteredList : setPredicate(p)
activate FilteredList
loop each person in the full directory
    FilteredList -> Predicate : test(person)
    activate Predicate
    note right of Predicate
    Case-insensitive substring match:
    "Alice Tan" contains "ali".
    end note
    Predicate --> FilteredList : matches
    deactivate Predicate
end
FilteredList --> Model
deactivate FilteredList
Model --> FindCommand
deactivate Model

note over FilteredList, SortedList
SortedList wraps filteredPersons
and retains the selected ordering.
end note

FindCommand -> Model : getFilteredPersonList()
activate Model
Model --> FindCommand : sortedPersons
deactivate Model
FindCommand -> SortedList : size()
activate SortedList
SortedList --> FindCommand : count
deactivate SortedList

create CommandResult
FindCommand -> CommandResult : new CommandResult(formatted count message)
activate CommandResult
CommandResult --> FindCommand : r
deactivate CommandResult
FindCommand --> LogicManager : r
deactivate FindCommand
LogicManager -> FindCommand : requiresSave()
activate FindCommand
FindCommand --> LogicManager : false
deactivate FindCommand
[<-- LogicManager : r
deactivate LogicManager
@enduml
