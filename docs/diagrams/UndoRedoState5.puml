@startuml
!include style.puml
skinparam ClassFontColor #000000
skinparam ClassBorderColor #000000
skinparam ClassBackgroundColor #FFFFAA
skinparam FooterFontColor #000000
skinparam FooterFontSize 13

title After command "clear"

package "addressBookStateList" as States {
    class State1 as "<u>ab0:AddressBook</u>"
    class State2 as "<u>ab1:AddressBook</u>"
    class State3 as "<u>ab3:AddressBook</u>"
}

State1 -[hidden]right-> State2
State2 -[hidden]right-> State3

class Pointer as "currentStatePointer = 2" #FFFFFF

Pointer -up-> State3
footer Undone snapshot ab2 is discarded.\nThe cleared directory is saved as ab3.
@enduml
